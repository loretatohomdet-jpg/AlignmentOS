# Database (required)
# If nothing is listening on 127.0.0.1:5432, start Postgres from the repo root:
#   docker compose up -d
# Then run migrations: cd backend && npx prisma migrate deploy
DATABASE_URL="postgresql://alignment:alignment@127.0.0.1:5432/alignment_index_db?schema=public"

# Auth (required in production — use a long random string)
JWT_SECRET="your-secret-here"

# Optional: frontend URL for password-reset, welcome emails, Stripe success redirect
APP_URL="http://localhost:3000"

# Optional: restrict CORS to your frontend (comma-separated for multiple origins)
# CORS_ORIGIN="https://www.alignmentos.co,https://alignmentos.co"

# --- Stripe (Habit Engine + Journey checkout) ---
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PRICE_HABIT_MONTHLY="price_..."
# STRIPE_PRICE_HABIT_YEARLY="price_..."
# STRIPE_PRICE_JOURNEY="price_..."

# --- ConvertKit / Kit (email list) ---
# 1. Kit → Settings → Advanced → copy your API key (public key is fine for subscribe)
# 2. Kit → Grow → Landing Pages & Forms → open your form → Form ID is in the URL (e.g. .../forms/1234567/edit)
# 3. Add these on Railway (backend service), then redeploy:
# CONVERTKIT_API_KEY="your_api_key"
# CONVERTKIT_FORM_ID="1234567"
# Optional tags (Kit → Grow → Tags → click tag → ID in URL):
# CONVERTKIT_TAG_LEAD="..."
# CONVERTKIT_TAG_REGISTERED="..."
# CONVERTKIT_TAG_PAID="..."

# Optional: Resend for transactional email (password reset; lead welcome; daily habit follow-up)
# RESEND_API_KEY="re_..."
# RESEND_FROM="Alignment OS <onboarding@yourdomain.com>"
# Optional: protect POST /api/cron/habit-nudges (Railway cron). The API also checks every 15 min when Resend is set.
# CRON_SECRET="long-random-string"

# Optional: OpenAI for AI Agent
# OPENAI_API_KEY="sk-..."
# OPENAI_AGENT_MODEL="gpt-4o-mini"
