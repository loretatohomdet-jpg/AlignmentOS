generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  avatarUrl String?
  /** Opaque token for public /s/:token score card (no PII beyond first name on share page). */
  shareToken String? @unique
  role      Role     @default(USER)
  plan      Plan     @default(FREE)
  stripeCustomerId     String? @unique
  stripeSubscriptionId String?
  /** Daily habit follow-up email (UTC hour). Paid plans only at send time. */
  habitNudgeEnabled Boolean   @default(true)
  habitNudgeHour    Int       @default(8)
  lastHabitNudgeAt  DateTime?
  /** When set, user cannot sign in (moderation). */
  suspendedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responses        Response[]
  scores           AlignmentIndexScore[]
  alignmentProfiles AlignmentProfile[]
  activeHabits     ActiveHabit[]
  reflections      Reflection[]
  dayRituals       DayRitual[]
  adminNotesAbout  AdminUserNote[] @relation("AdminNoteSubject")
  adminNotesAuthored AdminUserNote[] @relation("AdminNoteAuthor")
}

/** Weekly / quarterly written reflections (stored server-side; Reflect page). */
model Reflection {
  id        String         @id @default(uuid())
  userId    String
  type      ReflectionType
  answers   Json
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum ReflectionType {
  WEEKLY
  QUARTERLY
}

/** Morning / midday / evening rooms for one UTC day. */
model DayRitual {
  id        String        @id @default(uuid())
  userId    String
  day       String
  kind      DayRitualKind
  answers   Json
  heldAt    DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day, kind])
  @@index([userId, day])
  @@index([userId, heldAt])
}

enum DayRitualKind {
  MORNING
  MIDDAY
  CLOSE
}

/** Internal support / moderation notes on a user (visible to admins only). */
model AdminUserNote {
  id        String   @id @default(uuid())
  userId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  subject User @relation("AdminNoteSubject", fields: [userId], references: [id], onDelete: Cascade)
  author  User @relation("AdminNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum Plan {
  FREE
  PRO
  TEAM
}

model Lead {
  id        String   @id @default(uuid())
  email     String
  source    String?  @default("lander")
  pendingReport Json?
  createdAt DateTime @default(now())

  @@index([email, source])
  @@index([createdAt])
}

model Assessment {
  id          String    @id @default(uuid())
  title       String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  questions         Question[]
  responses         Response[]
  scores            AlignmentIndexScore[]
  alignmentProfiles AlignmentProfile[]
}

enum Pillar {
  IDENTITY
  PURPOSE
  MINDSET
  HABITS
  ENVIRONMENT
  EXECUTION
}

enum QuestionType {
  STANDARD
  PENALTY
}

model Question {
  id           String       @id @default(uuid())
  assessmentId String
  text         String
  order        Int
  scaleMin     Int          @default(1)
  scaleMax     Int          @default(5)
  pillar       Pillar
  questionType QuestionType @default(STANDARD)

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  responses  Response[]
}

model AlignmentProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  assessmentId  String
  aqScore       Float
  primaryDomain String?
  archetype     String?
  pillarScores  Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment   Assessment    @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  activeHabits ActiveHabit[]

  @@index([userId, createdAt])
}

model Response {
  id           String   @id @default(uuid())
  userId       String
  assessmentId String
  questionId   String
  value        Int
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model AlignmentIndexScore {
  id           String   @id @default(uuid())
  userId       String
  assessmentId String
  score        Float
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Habit {
  id          String   @id @default(uuid())
  title       String
  description String?
  level       Int
  pillar      Pillar
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  activeHabits ActiveHabit[]
}

model ActiveHabit {
  id         String    @id @default(uuid())
  userId     String
  habitId    String
  profileId  String?
  assignedAt DateTime  @default(now())
  /** Set when a later diagnostic replaces this practice. Completions are kept. */
  endedAt    DateTime?

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit    Habit             @relation(fields: [habitId], references: [id], onDelete: Cascade)
  profile  AlignmentProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  completions HabitCompletion[]

  @@unique([userId, habitId])
  @@index([userId])
  @@index([userId, endedAt])
}

model HabitCompletion {
  id             String   @id @default(uuid())
  activeHabitId  String
  completedAt    DateTime @default(now())

  activeHabit ActiveHabit @relation(fields: [activeHabitId], references: [id], onDelete: Cascade)

  @@index([activeHabitId, completedAt])
}

enum Role {
  USER
  ADMIN
}

/** Editable marketing / product page copy. System rows are seeded; custom rows are created in Admin. */
model SitePage {
  id          String   @id @default(uuid())
  slug        String   @unique
  path        String   @unique
  title       String
  pageGroup   String   @default("marketing")
  eyebrow     String?
  headline    String?
  subhead     String?
  body        String?
  ctaLabel    String?
  ctaHref     String?
  isPublished Boolean  @default(true)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([pageGroup, isPublished])
}

/** Shop / planner offers the Admin desk can create, edit, or hide. */
model ShopOffer {
  id           String   @id @default(uuid())
  sku          String   @unique
  name         String
  path         String
  kicker       String?
  tagline      String?
  body         String?
  image        String?
  digitalPrice Int?
  printPrice   Int?
  digitalUrl   String?
  printUrl     String?
  isPublished  Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isPublished, sortOrder])
}

