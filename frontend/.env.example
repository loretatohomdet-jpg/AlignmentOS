# API (required in production builds)
# VITE_API_BASE_URL=https://your-api.up.railway.app/api

# Optional — outbound links to GoHighLevel, Teachable, etc. (set in Vercel → Environment Variables)
# VITE_PROGRAM_HUB_URL=https://your-subdomain.msgsndr.com/
# VITE_COURSE_LIBRARY_URL=https://your-school.teachable.com/
# VITE_BOOKING_URL=https://your-calendar-or-ghl-link
# VITE_CHECKOUT_HABIT_URL=https://...
# VITE_CHECKOUT_JOURNEY_URL=https://...
# VITE_COHORT_APPLY_URL=https://...  # Journey to Purpose — Guided ($997); optional — defaults to VITE_BOOKING_URL

# Shop / Shopify + Gumroad (planner + Reset, Clarity, Quarterly Review). No Alignment OS account required to buy.
# VITE_SHOPIFY_STORE_URL=https://your-store.myshopify.com
# VITE_SHOP_PLANNER_URL=https://your-store.myshopify.com/products/life-of-purpose-planner
# VITE_SHOP_PLANNER_HEIRLOOM_URL=https://your-store.myshopify.com/products/life-of-purpose-planner-heirloom
# VITE_SHOP_PLANNER_DIGITAL_URL=https://yourshop.gumroad.com/l/life-of-purpose-planner
# VITE_SHOP_RESET_URL=https://yourshop.gumroad.com/l/alignment-reset
# VITE_SHOP_CLARITY_URL=https://yourshop.gumroad.com/l/alignment-clarity
# VITE_SHOP_CLARITY_PRINT_URL=https://your-store.myshopify.com/products/alignment-clarity-print
# VITE_SHOP_QUARTERLY_URL=https://yourshop.gumroad.com/l/quarterly-review
# VITE_AMAZON_STORE_URL=https://www.amazon.com/s?me=YOUR_SELLER_ID
